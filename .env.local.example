# Opinly API key (used when BLOG_SOURCE=opinly, the production default)
OPINLY_API_KEY=

# Blog content source: "opinly" (default, live) or "github" (local/GitHub content)
BLOG_SOURCE=opinly

# Optional: override canonical site URL for metadata
# NEXT_PUBLIC_SITE_URL=https://www.reddydentalfl.com

# Landing page callback form (/offers/call-us). The browser posts directly, so this must be public.
NEXT_PUBLIC_CALL_US_WEBHOOK_URL=
